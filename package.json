{
  "name": "onyx-launcher-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "sync:release": "node scripts/sync-release.mjs",
    "build": "vinext build",
    "start": "next start",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.4",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.32",
    "typescript": "5.9.3",
    "vite": "^8.1.5",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
